# =============================================================================
# Ollama Orchestrator — Environment Variables
# All variables are optional. Defaults shown in comments.
# See src/config/envMapper.ts for the full mapping.
# =============================================================================

# Server Configuration
NODE_ENV=production
PORT=5100
ORCHESTRATOR_PORT=5100                        # default: 5100
ORCHESTRATOR_HOST=0.0.0.0                     # default: 0.0.0.0
ORCHESTRATOR_LOG_LEVEL=info                   # debug | info | warn | error
ORCHESTRATOR_USER_AGENT=                      # default: ollama-orchestrator/<version>

# Security
GRAFANA_ADMIN_PASSWORD=admin                  # REQUIRED: Change in production
ORCHESTRATOR_ENABLE_AUTH=false                 # default: false
ORCHESTRATOR_API_KEYS=                        # comma-separated
ORCHESTRATOR_ADMIN_API_KEYS=                  # comma-separated

# CORS
ORCHESTRATOR_CORS_ORIGINS=*                   # comma-separated origins, default: *
ORCHESTRATOR_RATE_LIMIT_WINDOW=900000         # ms, default: 900000 (15 min)
ORCHESTRATOR_RATE_LIMIT_MAX=100               # default: 100
ORCHESTRATOR_API_KEY_HEADER=                  # custom header name

# Feature Toggles
ORCHESTRATOR_ENABLE_QUEUE=true                # default: true
ORCHESTRATOR_ENABLE_CIRCUIT_BREAKER=true      # default: true
ORCHESTRATOR_ENABLE_METRICS=true              # default: true
ORCHESTRATOR_ENABLE_STREAMING=true            # default: true
ORCHESTRATOR_ENABLE_PERSISTENCE=true          # default: true

# Queue Settings
ORCHESTRATOR_QUEUE_MAX_SIZE=1000              # default: 1000
ORCHESTRATOR_QUEUE_TIMEOUT=300000             # ms, default: 300000 (5 min)
ORCHESTRATOR_QUEUE_PRIORITY_BOOST_INTERVAL=5000  # ms, default: 5000
ORCHESTRATOR_QUEUE_PRIORITY_BOOST_AMOUNT=5    # default: 5
ORCHESTRATOR_QUEUE_MAX_PRIORITY=100           # default: 100

# Load Balancer Weights (must sum to 1.0)
ORCHESTRATOR_LB_WEIGHT_LATENCY=0.35          # default: 0.35
ORCHESTRATOR_LB_WEIGHT_SUCCESS_RATE=0.30     # default: 0.30
ORCHESTRATOR_LB_WEIGHT_LOAD=0.20             # default: 0.20
ORCHESTRATOR_LB_WEIGHT_CAPACITY=0.15         # default: 0.15

# Load Balancer Thresholds
ORCHESTRATOR_LB_MAX_P95_LATENCY=5000         # ms, default: 5000
ORCHESTRATOR_LB_MIN_SUCCESS_RATE=0.95         # default: 0.95
ORCHESTRATOR_LB_LATENCY_PENALTY=0.5           # default: 0.5
ORCHESTRATOR_LB_ERROR_PENALTY=0.3             # default: 0.3

# Circuit Breaker
ORCHESTRATOR_CB_FAILURE_THRESHOLD=5           # default: 5
ORCHESTRATOR_CB_MAX_FAILURE_THRESHOLD=10      # default: 10
ORCHESTRATOR_CB_MIN_FAILURE_THRESHOLD=3       # default: 3
ORCHESTRATOR_CB_OPEN_TIMEOUT=120000           # ms, default: 120000 (2 min)
ORCHESTRATOR_CB_HALF_OPEN_TIMEOUT=60000       # ms, default: 60000 (1 min)
ORCHESTRATOR_CB_HALF_OPEN_MAX_REQUESTS=5      # default: 5
ORCHESTRATOR_CB_RECOVERY_SUCCESS_THRESHOLD=3  # default: 3
ORCHESTRATOR_CB_ERROR_RATE_WINDOW=60000       # ms, default: 60000 (1 min)
ORCHESTRATOR_CB_ERROR_RATE_THRESHOLD=0.5      # default: 0.5
ORCHESTRATOR_CB_ADAPTIVE_THRESHOLDS=true      # default: true
ORCHESTRATOR_CB_ERROR_RATE_SMOOTHING=0.3      # default: 0.3

# Health Checks
ORCHESTRATOR_HC_ENABLED=true                  # default: true
ORCHESTRATOR_HC_INTERVAL=30000                # ms, default: 30000 (30s)
ORCHESTRATOR_HC_TIMEOUT=5000                  # ms, default: 5000
ORCHESTRATOR_HC_MAX_CONCURRENT=10             # default: 10
ORCHESTRATOR_HC_RETRY_ATTEMPTS=2              # default: 2
ORCHESTRATOR_HC_RETRY_DELAY=1000              # ms, default: 1000
ORCHESTRATOR_HC_RECOVERY_INTERVAL=60000       # ms, default: 60000 (1 min)
ORCHESTRATOR_HC_FAILURE_THRESHOLD=3           # default: 3
ORCHESTRATOR_HC_SUCCESS_THRESHOLD=2           # default: 2
ORCHESTRATOR_HC_BACKOFF_MULTIPLIER=1.5        # default: 1.5

# Metrics & Monitoring
ORCHESTRATOR_METRICS_ENABLED=true             # default: true
ORCHESTRATOR_METRICS_PROMETHEUS_ENABLED=true  # default: true
ORCHESTRATOR_METRICS_PROMETHEUS_PORT=9090     # default: 9090
ORCHESTRATOR_PROMETHEUS_ENABLED=true          # alias for metrics.prometheusEnabled
ORCHESTRATOR_PROMETHEUS_PORT=9090             # alias for metrics.prometheusPort

# Streaming
ORCHESTRATOR_STREAMING_ENABLED=true           # default: true
ORCHESTRATOR_STREAMING_MAX_CONCURRENT=100     # default: 100
ORCHESTRATOR_STREAMING_TIMEOUT=300000         # ms, default: 300000 (5 min)
ORCHESTRATOR_STREAMING_BUFFER_SIZE=1024       # bytes, default: 1024
ORCHESTRATOR_STREAMING_TTFT_WEIGHT=0.6        # default: 0.6
ORCHESTRATOR_STREAMING_DURATION_WEIGHT=0.4    # default: 0.4
ORCHESTRATOR_STREAMING_STALL_THRESHOLD_MS=300000  # ms, default: 300000 (5 min)
ORCHESTRATOR_STREAMING_STALL_CHECK_INTERVAL_MS=10000  # ms, default: 10000
ORCHESTRATOR_STREAMING_MAX_HANDOFF_ATTEMPTS=2 # default: 2

# Tags Aggregation
ORCHESTRATOR_TAGS_CACHE_TTL=30000             # ms, default: 30000 (30s)
ORCHESTRATOR_TAGS_MAX_CONCURRENT=10           # default: 10
ORCHESTRATOR_TAGS_BATCH_DELAY=50              # ms, default: 50
ORCHESTRATOR_TAGS_REQUEST_TIMEOUT=5000        # ms, default: 5000

# Retry
ORCHESTRATOR_RETRY_MAX_RETRIES=2              # default: 2
ORCHESTRATOR_RETRY_DELAY=500                  # ms, default: 500
ORCHESTRATOR_RETRY_BACKOFF_MULTIPLIER=2       # default: 2
ORCHESTRATOR_RETRY_MAX_DELAY=5000             # ms, default: 5000
ORCHESTRATOR_RETRY_STATUS_CODES=503,502,504   # comma-separated

# Model Manager
ORCHESTRATOR_MM_MAX_RETRIES=3                 # default: 3
ORCHESTRATOR_MM_RETRY_DELAY_BASE=1000         # ms, default: 1000
ORCHESTRATOR_MM_WARMUP_TIMEOUT=60000          # ms, default: 60000 (1 min)
ORCHESTRATOR_MM_IDLE_THRESHOLD=1800000        # ms, default: 1800000 (30 min)
ORCHESTRATOR_MM_MEMORY_SAFETY_MARGIN=1.2      # default: 1.2
ORCHESTRATOR_MM_GB_PER_BILLION_PARAMS=0.75    # default: 0.75

# Persistence
ORCHESTRATOR_PERSISTENCE_PATH=./data          # default: ./data
ORCHESTRATOR_CONFIG_RELOAD_INTERVAL=0         # ms, 0 = disabled

# Ollama Settings (for docker-compose)
OLLAMA_HOST=0.0.0.0

# Frontend (Vite dev server only)
# VITE_PROXY_TARGET=http://localhost:5100     # Vite proxy backend target
# VITE_API_BASE_URL=http://localhost:5100     # API base URL for production builds
